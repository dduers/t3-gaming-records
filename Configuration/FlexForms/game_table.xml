<?xml version="1.0"?>
<T3DataStructure>
	<sheets>
		<!--
			################################
			  SHEET General Settings
			################################
		-->
		<sDEF>
			<ROOT>
				<sheetTitle>Settings</sheetTitle>
				<type>array</type>
				<el>
					<!-- order -->
					<settings.orderBy>
						<label>Sort By</label>
						<config>
							<default>title</default>
							<eval>required</eval>
							<type>select</type>
							<renderType>selectSingle</renderType>
							<items>
								<numIndex index="0" type="array">
									<numIndex index="0"></numIndex>
									<numIndex index="1"></numIndex>
								</numIndex>
								<numIndex index="1" type="array">
									<numIndex index="0">Title</numIndex>
									<numIndex index="1">title</numIndex>
								</numIndex>
								<numIndex index="2" type="array">
									<numIndex index="0">Creation date</numIndex>
									<numIndex index="1">crdate</numIndex>
								</numIndex>
								<numIndex index="3" type="array">
									<numIndex index="0">Last updated</numIndex>
									<numIndex index="1">tstamp</numIndex>
								</numIndex>
							</items>
						</config>
					</settings.orderBy>
					<!-- order direction  -->
					<settings.orderDirection>
						<label>Sort direction</label>
						<config>
							<default>asc</default>
							<eval>required</eval>
							<type>select</type>
							<renderType>selectSingle</renderType>
							<items>
								<numIndex index="0" type="array">
									<numIndex index="0"></numIndex>
									<numIndex index="1"></numIndex>
								</numIndex>
								<numIndex index="1" type="array">
									<numIndex index="0">Ascending</numIndex>
									<numIndex index="1">asc</numIndex>
								</numIndex>
								<numIndex index="2" type="array">
									<numIndex index="0">Descending</numIndex>
									<numIndex index="1">desc</numIndex>
								</numIndex>
							</items>
						</config>
					</settings.orderDirection>
					<!-- startingpoint -->
					<settings.gameDataPids>
						<label>Starting point</label>
						<config>
							<type>group</type>
							<allowed>pages</allowed>
							<size>3</size>
							<maxitems>50</maxitems>
							<minitems>0</minitems>
						</config>
					</settings.gameDataPids>
					<!-- recursive -->
					<settings.recursive>
						<label>Recursive</label>
						<config>
							<type>select</type>
							<renderType>selectSingle</renderType>
							<items>
								<numIndex index="1">
									<label></label>
									<value />
								</numIndex>
								<numIndex index="2">
									<label>0</label>
									<value>0</value>
								</numIndex>
								<numIndex index="3">
									<label>1</label>
									<value>1</value>
								</numIndex>
								<numIndex index="4">
									<label>2</label>
									<value>2</value>
								</numIndex>
								<numIndex index="5">
									<label>3</label>
									<value>3</value>
								</numIndex>
								<numIndex index="6">
									<label>4</label>
									<value>4</value>
								</numIndex>
								<numIndex index="7">
									<label>5</label>
									<value>250</value>
								</numIndex>
							</items>
						</config>
					</settings.recursive>
				</el>
			</ROOT>
		</sDEF>
		<!--
			################################
			  SHEET Additional
			################################
		-->
		<additional>
			<ROOT>
				<sheetTitle>Additional</sheetTitle>
				<type>array</type>
				<el>
					<!-- PID Detail Page -->
					<settings.gameDetailPid>
						<label>Detail page</label>
						<config>
							<type>group</type>
							<allowed>pages</allowed>
							<relationship>manyToOne</relationship>
							<size>1</size>
							<maxitems>1</maxitems>
							<minitems>0</minitems>
							<suggestOptions>
								<default>
									<addWhere>AND pages.doktype NOT in (6,199,254)</addWhere>
								</default>
							</suggestOptions>
						</config>
					</settings.gameDetailPid>
					<!-- PID List Page -->
					<settings.gameListPid>
						<label>List page</label>
						<config>
							<type>group</type>
							<allowed>pages</allowed>
							<relationship>manyToOne</relationship>
							<size>1</size>
							<maxitems>1</maxitems>
							<minitems>0</minitems>
							<suggestOptions>
								<default>
									<addWhere>AND pages.doktype NOT in (6,199,254)</addWhere>
								</default>
							</suggestOptions>
						</config>
					</settings.gameListPid>
					<!-- PID Back -->
					<settings.gameBackPid>
						<label>Return to page</label>
						<config>
							<type>group</type>
							<allowed>pages</allowed>
							<relationship>manyToOne</relationship>
							<size>1</size>
							<maxitems>1</maxitems>
							<minitems>0</minitems>
							<suggestOptions>
								<default>
									<addWhere>AND pages.doktype NOT in (6,199,254)</addWhere>
								</default>
							</suggestOptions>
						</config>
					</settings.gameBackPid>
				</el>
			</ROOT>
		</additional>

		<options>
			<ROOT>
				<sheetTitle>Options</sheetTitle>
				<type>array</type>
				<el>
					<!-- order -->
					<settings.enableGameDetailLink>
						<label>Enable Details Link</label>
						<config>
							<type>check</type>
							<renderType>checkboxToggle</renderType>
						</config>
					</settings.enableGameDetailLink>
				</el>
			</ROOT>
		</options>
	</sheets>
</T3DataStructure>