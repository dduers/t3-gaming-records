page {
    includeCSS {
        highcharts = //cdnjs.cloudflare.com/ajax/libs/highcharts/12.3.0/css/highcharts.css
        highcharts.integrity = sha512-HcBrkS08ptJ9SXB/htzWLwxVNC0gZzJJKxtNiIULX1g8pBg3NwWZHklDEzWBYknV+sYUQMrwwy4eUBgvqwi1nw==
        highcharts.crossorigin = anonymous
        highcharts.external = 1
    }
    includeJSFooter {
        highcharts = https://cdnjs.cloudflare.com/ajax/libs/highcharts/12.3.0/highcharts.js
        highcharts.type = module
        highcharts.integrity = sha512-8TKmTrSzqd19b6/QDfZ6KHEj2wCIGMPQtw6HtYI/XlOiraFS3kKkfX8Dx0rffm9zhH3ap18vhaaEc/e1MvI7jw==
        highcharts.crossorigin = anonymous
        highcharts.external = 1

        highcharts.custom = EXT:t3_gaming_records/Resources/Public/JavaScript/Modules/highcharts.js
        highcharts.custom.type = module
    }
}
