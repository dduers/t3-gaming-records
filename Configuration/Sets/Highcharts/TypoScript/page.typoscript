page {
    includeCSS {
        highcharts = //cdnjs.cloudflare.com/ajax/libs/highcharts/12.3.0/css/highcharts.min.css
        highcharts.integrity = sha512-+a0VBSmFJGVTpQQ1FFkPDN154qQKqmjAgvSdtJ6S0k8VI+ZUfR/maLR2ZJL9WV86jh32Q2nnVeuIaBklTJcrOQ==
        highcharts.crossorigin = anonymous
        highcharts.external = 1
    }
    includeJSFooter {
        highcharts = //cdnjs.cloudflare.com/ajax/libs/highcharts/12.3.0/highcharts.min.js
        // highcharts.type = module
        highcharts.integrity = sha512-tkZqfvBew1MlYeX9cAnyjeKQuw2DaHjP7BFyhKqQV7QQCJL5nEOjhpgnCg1gBiigLN0qc4jhwNjzHn56myPsrw==
        highcharts.crossorigin = anonymous
        highcharts.external = 1

        highcharts.custom = EXT:t3_gaming_records/Resources/Public/JavaScript/Modules/highcharts.js
        highcharts.custom.type = module
    }
}
